# Neon Postgres connection string (Dashboard → Connection Details → pooled)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Random 32+ character string used to sign admin session cookies.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET="replace-me-with-a-long-random-string"

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@deedi.co.uk"
ADMIN_PASSWORD="DeediAdmin2026!"
ADMIN_NAME="Deedi Administrator"

# Image uploads. On Vercel, add a Blob store under the project's Storage tab and
# this is injected automatically. Copy it here too so local uploads land in the
# same place — otherwise they are written to public/images/uploads, which only
# `next dev` serves and which production cannot see.
BLOB_READ_WRITE_TOKEN=""

# Public site URL — used for canonical tags, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
